{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "com.ejunz.edge.desktop",
  "version": "2.0.0",
  "defaultMode": "window",
  "port": 59201,
  "documentRoot": "/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": false,
    "writeToLogFile": false
  },
  "nativeAllowList": [
    "app.*",
    "os.*",
    "computer.*",
    "filesystem.*",
    "storage.*",
    "debug.log"
  ],
  "modes": {
    "window": {
      "title": "Ejunz Edge",
      "width": 1280,
      "height": 800,
      "minWidth": 900,
      "minHeight": 600,
      "center": true,
      "fullScreen": false,
      "alwaysOnTop": false,
      "enableInspector": false,
      "borderless": false,
      "maximize": false,
      "hidden": false,
      "resizable": true,
      "exitProcessOnClose": true
    }
  },
  "cli": {
    "binaryName": "ejunz-edge-desktop",
    "resourcesPath": "/",
    "extensionsPath": "/extensions/",
    "binaryVersion": "5.5.0",
    "clientVersion": "5.4.0",
    "frontendLibrary": {
      "projectPath": "/",
      "initCommand": "",
      "devCommand": "",
      "buildCommand": "",
      "patchFile": "/index.html",
      "devUrl": "http://localhost:5175/"
    }
  }
}

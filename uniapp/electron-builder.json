{
  "appId": "com.ejunz.edge.desktop",
  "productName": "Ejunz Edge",
  "directories": {
    "output": "dist/electron"
  },
  "files": [
    "dist/build/desktop/**/*",
    "package.json"
  ],
  "win": {
    "target": ["nsis", "portable"],
    "icon": "static/icon.png",
    "artifactName": "Ejunz-Edge-Setup-${version}.${ext}"
  },
  "mac": {
    "target": ["dmg", "zip"],
    "icon": "static/icon.png",
    "artifactName": "Ejunz-Edge-${version}-mac.${ext}",
    "category": "public.app-category.utilities"
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "icon": "static/icon",
    "artifactName": "Ejunz-Edge-${version}-linux.${ext}",
    "category": "Utility"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true
  }
}

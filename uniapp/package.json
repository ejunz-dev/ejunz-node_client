{
  "name": "@ejunz/node-client-uniapp",
  "version": "1.1.6",
  "private": true,
  "type": "module",
  "description": "Ejunz Edge desktop and multi-platform client",
  "author": "Ejunz",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:h5": "uni -p h5",
    "build:h5": "uni build -p h5",
    "dev:app": "uni -p app",
    "build:app": "uni build -p app",
    "dev:app-android": "uni -p app --platform android",
    "build:app-android": "uni build -p app --platform android",
    "dev:app-ios": "uni -p app --platform ios",
    "build:app-ios": "uni build -p app --platform ios",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:mp-weixin": "uni build -p mp-weixin",
    "dev:mp-alipay": "uni -p mp-alipay",
    "build:mp-alipay": "uni build -p mp-alipay",
    "dev:mp-baidu": "uni -p mp-baidu",
    "build:mp-baidu": "uni build -p mp-baidu",
    "dev:mp-toutiao": "uni -p mp-toutiao",
    "build:mp-toutiao": "uni build -p mp-toutiao",
    "dev:mp-qq": "uni -p mp-qq",
    "build:mp-qq": "uni build -p mp-qq",
    "dev:quickapp": "uni -p quickapp-webview",
    "build:quickapp": "uni build -p quickapp-webview",
    "dev:desktop": "concurrently --kill-others-on-fail \"yarn dev:h5\" \"wait-on http://localhost:5175 && cross-env ELECTRON_START_URL=http://localhost:5175 electron electron/main.cjs\"",
    "build:h5:electron": "cross-env ELECTRON_BUILD=1 yarn build:h5",
    "build:desktop": "cross-env ELECTRON_CACHE=.cache/electron ELECTRON_BUILDER_CACHE=.cache/electron-builder yarn build:h5:electron && cross-env ELECTRON_CACHE=.cache/electron ELECTRON_BUILDER_CACHE=.cache/electron-builder electron-builder --config electron-builder.yml --publish never",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-alpha-5020320260731001",
    "@dcloudio/uni-app-plus": "3.0.0-alpha-5020320260731001",
    "@dcloudio/uni-h5": "3.0.0-alpha-5020320260731001",
    "@dcloudio/uni-mp-alipay": "3.0.0-alpha-5020320260731001",
    "@dcloudio/uni-mp-baidu": "3.0.0-alpha-5020320260731001",
    "@dcloudio/uni-mp-qq": "3.0.0-alpha-5020320260731001",
    "@dcloudio/uni-mp-toutiao": "3.0.0-alpha-5020320260731001",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-5020320260731001",
    "@dcloudio/uni-quickapp-webview": "3.0.0-alpha-5020320260731001",
    "pinia": "^3.0.3",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.32",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5020320260731001",
    "@types/node": "^22.15.0",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "sass-embedded": "^1.89.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vue-tsc": "^2.2.10",
    "wait-on": "^9.1.0"
  }
}

{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Ejunz Edge",
  "version": "2.0.0",
  "identifier": "com.ejunz.edge.desktop",
  "build": {
    "frontendDist": "../dist/build/h5",
    "devUrl": "http://localhost:5175",
    "beforeDevCommand": "yarn dev:h5",
    "beforeBuildCommand": "yarn build:h5"
  },
  "app": {
    "windows": [
      {
        "title": "Ejunz Edge",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}

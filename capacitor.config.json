{
  "appId": "dev.ejunz.node",
  "appName": "Ejunz Node",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "http",
    "iosScheme": "https",
    "allowNavigation": [
      "*"
    ]
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": false
    }
  },
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#1a1a2e"
  },
  "android": {
    "backgroundColor": "#1a1a2e"
  }
}
